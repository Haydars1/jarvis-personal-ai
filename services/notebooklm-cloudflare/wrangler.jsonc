{
  "name": "hayirlievlad-notebooklm-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [{
    "class_name": "NotebookLmContainer",
    "image": "./Dockerfile",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{
      "name": "NOTEBOOKLM_CONTAINER",
      "class_name": "NotebookLmContainer"
    }]
  },
  "exports": {
    "NotebookLmContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
